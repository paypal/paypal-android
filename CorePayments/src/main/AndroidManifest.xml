<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <provider
            android:name=".browserswitch.AuthTabRegistryInitializer"
            android:authorities="${applicationId}.paypal-core-payments-auth-tab-init"
            android:exported="false" />
    </application>

    <queries>
        <package android:name="com.paypal.android.p2pmobile" />

        <!-- Needed on Android 11+ so GetReturnToAppStrategyUseCase can resolve the default
             browser and check whether it supports App Links. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>
